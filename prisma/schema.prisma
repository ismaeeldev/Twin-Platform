// Prisma schema for AI Digital Twin Platform (Phase 1 MVP).
// Exact contract: docs/DataModel.md — do not rename fields/enum values without updating that file first.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum WorkflowType {
  SUPPORT_REPLY
  SALES_EMAIL
  CONTRACT_REVIEW
}

enum TaskStatus {
  NEW
  AI_DRAFTING
  PENDING_APPROVAL
  APPROVED
  REJECTED
  EDITED
  ESCALATED
  CLOSED
}

enum DecisionAction {
  APPROVE
  REJECT
  EDIT_APPROVE
  ESCALATE
}

enum EvalTagValue {
  GOOD
  NEEDS_EDIT
  BAD
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String
  name          String?
  hasOnboarded  Boolean  @default(false)
  createdAt     DateTime @default(now())

  tasks     Task[]
  decisions Decision[] @relation("DecisionActor")
}

model Task {
  id            String       @id @default(cuid())
  userId        String
  workflowType  WorkflowType
  inboundText   String
  contextNotes  String?
  status        TaskStatus   @default(NEW)
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  user      User       @relation(fields: [userId], references: [id])
  aiDrafts  AiDraft[]
  decisions Decision[]
  evalTags  EvalTag[]

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model AiDraft {
  id               String   @id @default(cuid())
  taskId           String
  draftText        String
  confidenceScore  Float
  riskFlags        String[]
  reasoning        String
  rawJson          Json
  createdAt        DateTime @default(now())

  task Task @relation(fields: [taskId], references: [id])

  @@index([taskId])
}

model Decision {
  id            String         @id @default(cuid())
  taskId        String
  action        DecisionAction
  editedText    String?
  actorUserId   String
  createdAt     DateTime       @default(now())

  task      Task @relation(fields: [taskId], references: [id])
  actorUser User @relation("DecisionActor", fields: [actorUserId], references: [id])

  @@index([taskId])
  @@index([createdAt])
  @@index([action])
}

model EvalTag {
  id        String       @id @default(cuid())
  taskId    String
  tag       EvalTagValue
  createdAt DateTime     @default(now())

  task Task @relation(fields: [taskId], references: [id])

  @@index([taskId])
}
